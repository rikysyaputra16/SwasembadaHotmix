{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swasembada-hotmix",
  "main": "src/index.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swasembada-hotmix",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROOFS",
      "bucket_name": "swasembada-hotmix-proofs"
    }
  ],
  "observability": {
    "enabled": true
  }
}
