{
  "name": "swasembada-hotmix-cloudflare",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply swasembada-hotmix --local",
    "db:migrate:remote": "wrangler d1 migrations apply swasembada-hotmix --remote",
    "db:list:local": "wrangler d1 migrations list swasembada-hotmix --local",
    "db:list:remote": "wrangler d1 migrations list swasembada-hotmix --remote",
    "proofs:migrate": "node scripts/upload-r2-proofs.mjs",
    "db:seed:local": "wrangler d1 execute swasembada-hotmix --local --file=./private-migration/current-data.sql",
    "db:seed:remote": "wrangler d1 execute swasembada-hotmix --remote --file=./private-migration/current-data.sql"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
